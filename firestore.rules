rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Strictly verify authorized Agency Admin UID
    function isAdmin() {
      return request.auth != null && request.auth.uid == "dZUgNFj1Eibu96JwFXEDiWCS1XA2";
    }

    // 1. Customer consultation bookings collection
    match /event_enquiries/{enquiryId} {
      // Allow any visitor to submit an enquiry if required fields exist
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.eventType is string;

      // Strictly the authorized Agency Admin can read, update status, and delete
      allow read, update, delete: if isAdmin();
    }

    // 2. Email notification queue collection (for Firebase Trigger Email extension)
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 3. Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
